cmake_minimum_required(VERSION 3.18)
# 在宿主重复启动同一个 CTest 条目，沿用其本机、adb 或 iOS 设备部署入口。
set(scenarios writeWithoutLock.warm realSize.mapped realSize.unmapped clear.4KiB)
set(config_args)
if(CONFIG)
    list(APPEND config_args -C "${CONFIG}")
endif()

# 公共计时器输出三位小数的 ns，换算为整数 ps 后比较，不丢弃慢批。
function(picoseconds value output)
    string(REPLACE "." "" digits "${value}")
    string(REGEX REPLACE "^0+" "" digits "${digits}")
    if(digits STREQUAL "")
        message(FATAL_ERROR "Zero benchmark duration: ${value}")
    endif()
    set(${output} "${digits}" PARENT_SCOPE)
endfunction()

set(unstable FALSE)
set(duration "[0-9]+[.][0-9][0-9][0-9]")
foreach(batch RANGE 1 2)
    foreach(run RANGE 0 5)
        execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" -V -R "^SharedMemoryTestBenchmark$" ${config_args}
            WORKING_DIRECTORY "${BUILD_DIR}" RESULT_VARIABLE status OUTPUT_VARIABLE log ERROR_VARIABLE error)
        if(NOT status STREQUAL "0")
            message(FATAL_ERROR "Benchmark process ${run} failed\n${log}\n${error}")
        endif()
        foreach(scenario IN LISTS scenarios)
            string(REPLACE "." "[.]" pattern "${scenario}")
            string(REGEX MATCHALL "\\[BENCH\\] SharedMemory[.]${pattern} [^\r\n]*" rows "${log}")
            list(LENGTH rows count)
            if(NOT count EQUAL 1 OR NOT rows MATCHES " iterations=[1-9][0-9]* ops_per_iteration=1 median_ns=(${duration}) q1_ns=(${duration}) q3_ns=(${duration}) samples_ns=([0-9.,]+) checksum=([0-9a-fA-F]+)$")
                message(FATAL_ERROR "Missing or invalid benchmark result for ${scenario}: ${log}")
            endif()
            set(median "${CMAKE_MATCH_1}")
            set(q1 "${CMAKE_MATCH_2}")
            set(q3 "${CMAKE_MATCH_3}")
            string(REPLACE "," ";" samples "${CMAKE_MATCH_4}")
            string(LENGTH "${CMAKE_MATCH_5}" checksum_length)
            list(LENGTH samples sample_count)
            if(NOT sample_count EQUAL 9 OR NOT checksum_length EQUAL 16)
                message(FATAL_ERROR "Incomplete benchmark record: ${rows}")
            endif()
            set(sorted_samples)
            foreach(sample IN LISTS samples)
                if(NOT sample MATCHES "^${duration}$")
                    message(FATAL_ERROR "Invalid sample in: ${rows}")
                endif()
                picoseconds("${sample}" ps)
                list(APPEND sorted_samples "${ps}")
            endforeach()
            list(SORT sorted_samples COMPARE NATURAL)
            list(GET sorted_samples 2 low)
            list(GET sorted_samples 4 mid)
            list(GET sorted_samples 6 high)
            picoseconds("${q1}" reported_low)
            picoseconds("${median}" reported_mid)
            picoseconds("${q3}" reported_high)
            if(NOT low STREQUAL reported_low OR NOT mid STREQUAL reported_mid OR NOT high STREQUAL reported_high)
                message(FATAL_ERROR "Quartiles disagree with the nine samples: ${rows}")
            endif()
            message(STATUS "batch=${batch} run=${run} ${rows}")
            if(run GREATER 0)
                list(APPEND medians_${scenario} "${mid}")
                math(EXPR limit "${low} * 11 / 10")
                if(high GREATER limit)
                    set(unstable TRUE)
                    message(STATUS "${scenario}: check within-process spread (run ${run})")
                endif()
            endif()
        endforeach()
    endforeach()
    foreach(scenario IN LISTS scenarios)
        list(SORT medians_${scenario} COMPARE NATURAL)
        list(GET medians_${scenario} 0 low)
        list(GET medians_${scenario} 2 median)
        list(GET medians_${scenario} 4 high)
        message(STATUS "${scenario}: process medians (ps/call) = ${medians_${scenario}}, median = ${median}")
        list(APPEND centers_${scenario} "${median}")
        unset(medians_${scenario})
        math(EXPR limit "${low} * 11 / 10")
        if(high GREATER limit)
            set(unstable TRUE)
            message(STATUS "${scenario}: between-process spread exceeds 10%")
        endif()
    endforeach()
endforeach()
foreach(scenario IN LISTS scenarios)
    list(SORT centers_${scenario} COMPARE NATURAL)
    list(GET centers_${scenario} 0 low)
    list(GET centers_${scenario} 1 high)
    math(EXPR limit "${low} * 11 / 10")
    message(STATUS "${scenario}: two batch medians (ps/call, ascending) = ${centers_${scenario}}")
    if(high GREATER limit)
        set(unstable TRUE)
        message(STATUS "${scenario}: between-batch spread exceeds 10%")
    endif()
endforeach()
if(unstable)
    message(FATAL_ERROR "Unstable samples. Keep the observations and exclude this batch from performance baselines.")
endif()