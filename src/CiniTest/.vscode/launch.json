{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Windows CiniTest Release",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/../../lib/CiniTest.exe",
            "cwd": "${workspaceFolder}",
            "args": [
                "--instant"
            ]
        },
        {
            "name": "CMake CiniTest",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}",
            "args": [
                "--instant"
            ],
            "linux": {
                "MIMode": "gdb"
            },
            "osx": {
                "MIMode": "lldb"
            }
        }
    ]
}