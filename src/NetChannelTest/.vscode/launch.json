{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "NetChannelTest（Linux、macOS）",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "--all"
            ],
            "cwd": "${workspaceFolder}",
            "linux": {
                "MIMode": "gdb"
            },
            "osx": {
                "MIMode": "lldb"
            }
        },
        {
            "name": "NetChannelTest（Windows，VS 构建）",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/../../lib/${input:netChannelTestExe}",
            "args": [
                "--all"
            ],
            "cwd": "${workspaceFolder}"
        }
    ],
    "inputs": [
        {
            "id": "netChannelTestExe",
            "type": "pickString",
            "description": "选择已通过 VS 构建的测试程序",
            "options": [
                "NetChannelTestd.exe",
                "NetChannelTest.exe"
            ]
        }
    ]
}