{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Windows · Debug（先生成对应的 .sln）",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/../../lib/HttpWorkTestd.exe",
            "cwd": "${workspaceFolder}",
            "args": []
        },
        {
            "name": "Windows · Release（先生成对应的 .sln）",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/../../lib/HttpWorkTest.exe",
            "cwd": "${workspaceFolder}",
            "args": []
        },
        {
            "name": "Linux / macOS · 当前 CMake 目标",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}",
            "linux": {
                "MIMode": "gdb"
            },
            "osx": {
                "MIMode": "lldb",
                "args": [
                    "--client",
                    "${input:httpFixtureOrigin}"
                ]
            },
            "args": []
        }
    ],
    "inputs": [
        {
            "id": "httpFixtureOrigin",
            "type": "promptString",
            "description": "已运行的 HttpWorkFixture 源站（使用 HttpWorkFixture --serve --port 58123 启动）",
            "default": "http://127.0.0.1:58123"
        }
    ]
}