cmake_minimum_required(VERSION 3.15)

# 在已配置的测试构建目录运行。每次 CTest 都重新启动目标进程或设备宿主。
if(NOT EXISTS "CTestTestfile.cmake" OR NOT EXISTS "CMakeCache.txt")
    message(FATAL_ERROR "Run from the configured CSystemTest build directory")
endif()
if(DEFINED MAX_SPREAD_PERCENT AND NOT MAX_SPREAD_PERCENT MATCHES "^(0|[1-9][0-9]*)$")
    message(FATAL_ERROR "MAX_SPREAD_PERCENT must be a non-negative whole percentage")
endif()
# 单配置生成器会忽略 ctest -C 对实际二进制配置的选择，必须先核对构建缓存。
load_cache("${CMAKE_CURRENT_BINARY_DIR}" READ_WITH_PREFIX suite_ CMAKE_CONFIGURATION_TYPES CMAKE_BUILD_TYPE)
set(configurations "${suite_CMAKE_CONFIGURATION_TYPES}")
if(NOT configurations)
    set(configurations "${suite_CMAKE_BUILD_TYPE}")
endif()
set(release_config "")
foreach(config IN LISTS configurations)
    string(TOUPPER "${config}" normalized)
    if(normalized STREQUAL "RELEASE")
        set(release_config "${config}")
        break()
    endif()
endforeach()
if(NOT release_config)
    message(FATAL_ERROR "The configured build does not provide Release")
endif()
# 按数值而非字典序插入，供九轮原始数据和五个进程中位数共用，兼容 CMake 3.15。
function(insert_sorted list_name value)
    set(position 0)
    foreach(existing IN LISTS ${list_name})
        if(value LESS existing)
            break()
        endif()
        math(EXPR position "${position} + 1")
    endforeach()
    list(INSERT ${list_name} ${position} "${value}")
    set(${list_name} "${${list_name}}" PARENT_SCOPE)
endfunction()

set(timing "[0-9]+[.][0-9][0-9][0-9]")
set(metrics filename extension joinPath)
set(names CSystem.GetName.filename CSystem.GetName.extension CSystem.joinPath)
foreach(round RANGE 0 5)
    execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" -C "${release_config}" -V -R "^CSystemTestBenchmark$"
        TIMEOUT 600 RESULT_VARIABLE status OUTPUT_VARIABLE log ERROR_VARIABLE errors)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Benchmark process ${round} failed\n${log}\n${errors}")
    endif()
    foreach(index RANGE 0 2)
        list(GET metrics ${index} key)
        list(GET names ${index} name)
        string(REPLACE "." "[.]" pattern "${name}")
        string(REGEX MATCHALL "\\[BENCH\\] ${pattern} [^\r\n]+" rows "${log}")
        list(LENGTH rows matches)
        if(NOT matches EQUAL 1)
            message(FATAL_ERROR "Expected one record for ${name} in process ${round}. Check LIBRARY_TEST_BENCHMARKS.")
        endif()
        # 字段顺序与 PlatformTest 的原始输出一致，P01 每次迭代只调用一次接口。
        if(NOT rows MATCHES "^\\[BENCH\\] ${pattern} iterations=[1-9][0-9]* ops_per_iteration=1 median_ns=(${timing}) q1_ns=(${timing}) q3_ns=(${timing}) samples_ns=([0-9.,]+) checksum=([0-9a-fA-F]+)[ \t]*$")
            message(FATAL_ERROR "Incomplete benchmark record for ${name} in process ${round}: ${rows}")
        endif()
        set(median_ns "${CMAKE_MATCH_1}")
        set(q1_ns "${CMAKE_MATCH_2}")
        set(q3_ns "${CMAKE_MATCH_3}")
        string(REPLACE "," ";" raw "${CMAKE_MATCH_4}")
        string(LENGTH "${CMAKE_MATCH_5}" checksum_length)
        if(NOT checksum_length EQUAL 16)
            message(FATAL_ERROR "Incomplete checksum for ${name} in process ${round}")
        endif()
        list(LENGTH raw count)
        if(NOT count EQUAL 9)
            message(FATAL_ERROR "Expected nine samples for ${name} in process ${round}")
        endif()
        set(ordered "")
        foreach(sample IN LISTS raw)
            if(NOT sample MATCHES "^${timing}$")
                message(FATAL_ERROR "Invalid raw sample for ${name} in process ${round}: ${sample}")
            endif()
            if(sample EQUAL 0)
                message(FATAL_ERROR "Timer resolution is insufficient for ${name} in process ${round}")
            endif()
            insert_sorted(ordered "${sample}")
        endforeach()
        list(GET ordered 2 first_quartile)
        list(GET ordered 4 middle)
        list(GET ordered 6 third_quartile)
        if(NOT first_quartile STREQUAL q1_ns OR NOT middle STREQUAL median_ns OR NOT third_quartile STREQUAL q3_ns)
            message(FATAL_ERROR "Reported quartiles or median disagree with raw samples for ${name} in process ${round}")
        endif()
        message(STATUS "process ${round}: ${rows}")
        if(round GREATER 0)
            string(REPLACE "." "" ps "${middle}")
            string(REGEX REPLACE "^0+" "" ps "${ps}")
            insert_sorted(samples_${key} "${ps}")
        endif()
    endforeach()
endforeach()

set(unstable FALSE)
foreach(index RANGE 0 2)
    list(GET metrics ${index} key)
    list(GET names ${index} name)
    list(GET samples_${key} 0 low)
    list(GET samples_${key} 2 median)
    list(GET samples_${key} 4 high)
    message(STATUS "${name} across 5 processes: median=${median} ps/call, min=${low}, max=${high}")
    if(DEFINED MAX_SPREAD_PERCENT)
        math(EXPR spread "((${high} - ${low}) * 100 + ${low} - 1) / ${low}")
        if(spread GREATER MAX_SPREAD_PERCENT)
            message(STATUS "${name} exceeds the configured spread of ${MAX_SPREAD_PERCENT}%")
            set(unstable TRUE)
        endif()
    endif()
endforeach()
if(unstable)
    message(FATAL_ERROR "Process medians exceed the requested repeatability tolerance")
endif()