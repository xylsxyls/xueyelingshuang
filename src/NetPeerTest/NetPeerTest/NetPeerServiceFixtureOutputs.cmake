cmake_minimum_required(VERSION 3.15)

# 每次使用独立目录，所有输出和故意设置的既有文件均属于本次用例。
string(RANDOM LENGTH 24 suffix)
set(directory "${CMAKE_CURRENT_BINARY_DIR}/NetPeerServiceFixtureOutputs-${suffix}")
if(EXISTS "${directory}")
    message(FATAL_ERROR "Fixture test directory already exists")
endif()
file(MAKE_DIRECTORY "${directory}")
set(certificate "${directory}/service.crt")
set(key "${directory}/service.key")

function(check_fixture_output)
    execute_process(COMMAND "${FIXTURE}" "${certificate}" "${directory}/./service.crt" RESULT_VARIABLE result)
    if(NOT "${result}" STREQUAL "1" OR EXISTS "${certificate}")
        set(failure "Aliased output paths left a fixture behind" PARENT_SCOPE)
        return()
    endif()

    file(WRITE "${key}" "existing key")
    execute_process(COMMAND "${FIXTURE}" "${certificate}" "${key}" RESULT_VARIABLE result)
    if(NOT "${result}" STREQUAL "1" OR EXISTS "${certificate}" OR NOT EXISTS "${key}")
        set(failure "Existing second output was replaced or first output was not rolled back" PARENT_SCOPE)
        return()
    endif()
    file(READ "${key}" contents)
    if(NOT "${contents}" STREQUAL "existing key")
        set(failure "Existing second output was modified" PARENT_SCOPE)
        return()
    endif()
    file(REMOVE "${key}")

    execute_process(COMMAND "${FIXTURE}" "${certificate}" "${key}" RESULT_VARIABLE result)
    if(NOT "${result}" STREQUAL "0" OR NOT EXISTS "${certificate}" OR NOT EXISTS "${key}")
        set(failure "Could not create both new outputs" PARENT_SCOPE)
        return()
    endif()
    file(SIZE "${certificate}" certificate_bytes)
    file(SIZE "${key}" key_bytes)
    file(SHA256 "${certificate}" certificate_hash)
    file(SHA256 "${key}" key_hash)
    execute_process(COMMAND "${FIXTURE}" "${certificate}" "${key}" RESULT_VARIABLE result)
    if(NOT "${result}" STREQUAL "1" OR NOT EXISTS "${certificate}" OR NOT EXISTS "${key}")
        set(failure "Existing fixture pair was not preserved" PARENT_SCOPE)
        return()
    endif()
    file(SHA256 "${certificate}" current_certificate_hash)
    file(SHA256 "${key}" current_key_hash)
    if(certificate_bytes EQUAL 0 OR key_bytes EQUAL 0 OR certificate_hash STREQUAL key_hash
        OR NOT certificate_hash STREQUAL current_certificate_hash OR NOT key_hash STREQUAL current_key_hash)
        set(failure "Fixture files were empty, identical, or overwritten" PARENT_SCOPE)
    endif()
endfunction()

check_fixture_output()
file(REMOVE_RECURSE "${directory}")
if(failure)
    message(FATAL_ERROR "${failure}")
endif()