include_guard(GLOBAL)

# 在 project() 之前按 BIT 选择 Linux ARM 工具链；显式工具链保留其编译器和 sysroot。
macro(platform_test_select_linux_arm)
    if(BIT MATCHES "^arm(32|64)$" AND NOT CMAKE_TOOLCHAIN_FILE AND
       (CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_SYSTEM_NAME STREQUAL "Linux"))
        if(BIT STREQUAL "arm32")
            set(test_arm_cpu arm)
            set(test_arm_triples arm-linux-gnueabihf arm-none-linux-gnueabihf)
            set(test_arm_host "^arm(v[5-8].*)?$")
        else()
            set(test_arm_cpu aarch64)
            set(test_arm_triples aarch64-linux-gnu aarch64-none-linux-gnu)
            set(test_arm_host "^(aarch64|arm64)$")
        endif()
        cmake_host_system_information(RESULT test_host_cpu QUERY OS_PLATFORM)
        if(NOT test_host_cpu MATCHES "${test_arm_host}")
            set(CMAKE_SYSTEM_NAME Linux)
            set(CMAKE_SYSTEM_PROCESSOR "${test_arm_cpu}")
            if(NOT CMAKE_CXX_COMPILER AND "$ENV{CXX}" STREQUAL "")
                set(test_arm_names)
                foreach(triple IN LISTS test_arm_triples)
                    list(APPEND test_arm_names "${triple}-g++")
                endforeach()
                find_program(test_arm_cxx_${BIT} NAMES ${test_arm_names})
                if(NOT test_arm_cxx_${BIT})
                    message(FATAL_ERROR "Set CMAKE_TOOLCHAIN_FILE or install ${test_arm_names} for ${BIT}")
                endif()
                set(CMAKE_CXX_COMPILER "${test_arm_cxx_${BIT}}")
            endif()
        endif()
    endif()
endmacro()

# 在当前 SDK 查找测试消费的原生库。单配置在配置时检查，多配置按实际构建配置选择。
# 参数 out 接收链接路径，name 是不含前缀、扩展名和 Debug 后缀的库名。
function(platform_test_sdk_library out name)
    if(CMAKE_CONFIGURATION_TYPES)
        set(variants release debug)
    elseif(CMAKE_BUILD_TYPE)
        string(TOLOWER "${CMAKE_BUILD_TYPE}" build_type)
        if(build_type STREQUAL "debug")
            set(variants debug)
        else()
            set(variants release)
        endif()
    elseif(DEBUGRELEASE STREQUAL "debug")
        set(variants debug)
    else()
        set(variants release)
    endif()

    foreach(variant IN LISTS variants)
        set(basename "${name}")
        if(variant STREQUAL "debug")
            string(APPEND basename d)
        endif()
        # find_library 默认缓存跨次配置的结果。切换 SDK、库类型或配置时必须重新查找。
        unset(_platform_test_archive CACHE)
        set(_platform_test_archive "_platform_test_archive-NOTFOUND")
        find_library(_platform_test_archive NAMES "${basename}" PATHS "${SDK_ROOT}/lib"
            NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
        set(${variant}_path "${_platform_test_archive}")
        unset(_platform_test_archive CACHE)
    endforeach()

    if(CMAKE_CONFIGURATION_TYPES)
        if(NOT debug_path AND NOT release_path)
            message(FATAL_ERROR "Missing ${name} and ${name}d in ${SDK_ROOT}/lib")
        endif()
        # SDK 可只准备一个配置。另一配置选到确切的缺件路径，不能静默改链已有的库。
        foreach(variant IN LISTS variants)
            if(NOT ${variant}_path)
                set(basename "${name}")
                if(variant STREQUAL "debug")
                    string(APPEND basename d)
                endif()
                set(${variant}_path "${SDK_ROOT}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}${basename}${CMAKE_STATIC_LIBRARY_SUFFIX}")
            endif()
        endforeach()
        set(selected "$<$<CONFIG:Debug>:${debug_path}>$<$<NOT:$<CONFIG:Debug>>:${release_path}>")
    else()
        set(selected "${${variants}_path}")
        if(NOT selected)
            message(FATAL_ERROR "Missing ${basename} in ${SDK_ROOT}/lib")
        endif()
    endif()
    set(${out} "${selected}" PARENT_SCOPE)
endfunction()

# 只从目标 SDK 取用各 Wasm 库公开头，避免回落到同名的原生宏。
function(platform_test_wasm_headers target sdk)
    foreach(library IN LISTS ARGN)
        if(NOT EXISTS "${sdk}/include/wasm/${library}/${library}API.h")
            message(FATAL_ERROR "Missing ${library} Wasm headers in ${sdk}/include/wasm. Prepare the target SDK with CloudRebuild.")
        endif()
    endforeach()
    target_include_directories(${target} BEFORE PRIVATE "${sdk}/include/wasm")
endfunction()

# 将消费工程链接到与当前平台和配置相符的 PlatformTest SDK。
function(platform_test_link target sdk)
    if(EMSCRIPTEN)
        platform_test_wasm_headers(${target} "${sdk}" PlatformTest)
        set(library "${sdk}/lib/PlatformTest$<$<CONFIG:Debug>:d>.a")
        if(NOT CMAKE_CONFIGURATION_TYPES AND NOT CMAKE_BUILD_TYPE AND DEBUGRELEASE STREQUAL "debug")
            set(library "${sdk}/lib/PlatformTestd.a")
        endif()
    else()
        if(NOT EXISTS "${sdk}/include/PlatformTest/PlatformTestAPI.h")
            message(FATAL_ERROR "Missing PlatformTest SDK in ${sdk}. Prepare it with CloudRebuild before configuring this test.")
        endif()
        set(SDK_ROOT "${sdk}")
        platform_test_sdk_library(library PlatformTest)
    endif()
    target_include_directories(${target} PRIVATE "${sdk}/include")
    target_link_libraries(${target} PRIVATE "${library}")
endfunction()


# 移动端和 Wasm 需要在宿主执行部署器和 HTTP 源站，分别配置两个工具链。
function(platform_test_host_tools target with_http)
    if(TARGET platform_test_host_build)
        if(with_http)
            set_property(TARGET platform_test_host_build PROPERTY PLATFORM_TEST_WITH_HTTP ON)
        endif()
        add_dependencies(${target} platform_test_host_build)
        return()
    endif()
    get_property(source GLOBAL PROPERTY PLATFORM_TEST_HOST_DIR)
    set(build "${CMAKE_BINARY_DIR}/platform-test-host")
    if(CMAKE_HOST_WIN32)
        set(extension .exe)
    endif()
    set_property(GLOBAL PROPERTY PLATFORM_DEVICE_RUNNER "${build}/bin/PlatformDeviceRunner${extension}")
    set_property(GLOBAL PROPERTY HTTPWORK_FIXTURE "${build}/bin/HttpWorkFixture${extension}")
    set(PLATFORM_TEST_HOST_GENERATOR "" CACHE STRING "Optional native CMake generator for host test tools")
    set(PLATFORM_TEST_HOST_CXX_COMPILER "" CACHE FILEPATH "Optional native C++11 host compiler")
    set(options)
    if(PLATFORM_TEST_HOST_GENERATOR)
        list(APPEND options -G "${PLATFORM_TEST_HOST_GENERATOR}")
    elseif(NOT CMAKE_CROSSCOMPILING)
        list(APPEND options -G "${CMAKE_GENERATOR}")
        if(CMAKE_GENERATOR_PLATFORM)
            list(APPEND options -A "${CMAKE_GENERATOR_PLATFORM}")
        endif()
    endif()
    if(PLATFORM_TEST_HOST_CXX_COMPILER)
        list(APPEND options "-DCMAKE_CXX_COMPILER=${PLATFORM_TEST_HOST_CXX_COMPILER}")
    elseif(NOT CMAKE_CROSSCOMPILING)
        list(APPEND options "-DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}")
    endif()
    set(clean_env "${CMAKE_COMMAND}" -E env --unset=CC --unset=CXX --unset=CFLAGS --unset=CXXFLAGS
        --unset=LDFLAGS --unset=CMAKE_TOOLCHAIN_FILE --unset=SDKROOT --unset=MACOSX_DEPLOYMENT_TARGET)
    add_custom_target(platform_test_host_build
        COMMAND ${clean_env} "${CMAKE_COMMAND}" -S "${source}" -B "${build}" ${options}
            -DCMAKE_BUILD_TYPE=Release "-DPLATFORM_TEST_WITH_HTTP=$<BOOL:$<TARGET_PROPERTY:platform_test_host_build,PLATFORM_TEST_WITH_HTTP>>"
        COMMAND ${clean_env} "${CMAKE_COMMAND}" --build "${build}" --config Release
        VERBATIM)
    set_property(TARGET platform_test_host_build PROPERTY PLATFORM_TEST_WITH_HTTP "${with_http}")
    add_dependencies(${target} platform_test_host_build)
endfunction()

option(LIBRARY_TEST_BENCHMARKS "Register the C++ library performance cases with CTest" OFF)
set_property(GLOBAL PROPERTY PLATFORM_TEST_HOST_DIR "${CMAKE_CURRENT_LIST_DIR}")

# 在 iOS 将原有 C++ main 接到签名测试应用，其他目标保留原入口。
function(configure_platform_test target main_source)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "iOS")
        return()
    endif()
    cmake_parse_arguments(test "TAKES_ARGS;LOCAL_NETWORK" "" "" ${ARGN})
    get_property(host GLOBAL PROPERTY PLATFORM_TEST_HOST_DIR)
    set_property(SOURCE "${main_source}" APPEND PROPERTY COMPILE_DEFINITIONS main=PlatformTestEntry)
    target_sources(${target} PRIVATE "${host}/PlatformTestApp.mm")
    set_source_files_properties("${host}/PlatformTestApp.mm" PROPERTIES LANGUAGE CXX COMPILE_FLAGS "-x objective-c++ -fobjc-arc")
    if(test_TAKES_ARGS)
        target_compile_definitions(${target} PRIVATE PLATFORM_TEST_TAKES_ARGS)
    endif()
    set(PLATFORM_TEST_BUNDLE_PREFIX "org.xueyelingshuang.tests" CACHE STRING "Bundle identifier prefix for signed iOS test apps")
    set(identifier "${PLATFORM_TEST_BUNDLE_PREFIX}.${target}")
    set(PLATFORM_TEST_LOCAL_NETWORK_USAGE "")
    if(test_LOCAL_NETWORK)
        set(PLATFORM_TEST_LOCAL_NETWORK_USAGE "<key>NSLocalNetworkUsageDescription</key><string>Connect to the configured HTTP test server on your local network.</string>")
    endif()
    set(plist "${CMAKE_CURRENT_BINARY_DIR}/${target}-Info.plist.in")
    configure_file("${host}/PlatformTestInfo.plist.in" "${plist}" @ONLY)
    set_target_properties(${target} PROPERTIES MACOSX_BUNDLE TRUE
        MACOSX_BUNDLE_GUI_IDENTIFIER "${identifier}"
        MACOSX_BUNDLE_INFO_PLIST "${plist}"
        XCODE_ATTRIBUTE_PRODUCT_BUNDLE_IDENTIFIER "${identifier}"
        XCODE_ATTRIBUTE_TARGETED_DEVICE_FAMILY "1,2" XCODE_GENERATE_SCHEME TRUE)
    target_link_libraries(${target} PRIVATE "-framework Foundation" "-framework UIKit")
endfunction()

# Android 部署独立 ELF，iOS 使用模拟器或已配对的签名设备，桌面仍由 CTest 直接执行。
function(add_platform_test name target)
    if(NOT ANDROID AND NOT CMAKE_SYSTEM_NAME STREQUAL "iOS")
        add_test(NAME ${name} COMMAND ${target} ${ARGN})
        return()
    endif()
    platform_test_host_tools(${target} OFF)
    get_property(runner GLOBAL PROPERTY PLATFORM_DEVICE_RUNNER)
    set(PLATFORM_TEST_DEVICE "" CACHE STRING "Android serial, iOS device UDID or simulator UDID")
    set(PLATFORM_TEST_RUNTIME_LIBRARIES "" CACHE STRING "Additional Android shared libraries to stage, e.g. libc++_shared.so")
    if(ANDROID)
        set(mode android)
        set(product "$<TARGET_FILE:${target}>")
        set(arguments --sdk-lib "${SDK_ROOT}/lib")
        foreach(library IN LISTS PLATFORM_TEST_RUNTIME_LIBRARIES)
            list(APPEND arguments --runtime "${library}")
        endforeach()
    else()
        if(CMAKE_OSX_SYSROOT MATCHES "[Ss]imulator")
            set(mode ios-simulator)
        else()
            set(mode ios-device)
        endif()
        set(product "$<TARGET_BUNDLE_DIR:${target}>")
        get_target_property(identifier ${target} MACOSX_BUNDLE_GUI_IDENTIFIER)
        set(arguments --identifier "${identifier}")
    endif()
    if(PLATFORM_TEST_DEVICE)
        list(APPEND arguments --device "${PLATFORM_TEST_DEVICE}")
    endif()
    add_test(NAME ${name} COMMAND "${runner}"
        ${mode} "${product}" ${arguments} -- ${ARGN})
    set_tests_properties(${name} PROPERTIES TIMEOUT 180 RESOURCE_LOCK "platform_device_${target}")
endfunction()

# Include after enable_testing(). Use LIBRARY_TEST_HOST=ON to package the same test for all three hosts.
option(LIBRARY_TEST_HOST "Build a modular browser, WeChat and Node test entry" OFF)
function(add_library_platform_test target)
    configure_platform_test(${target} "${target}.cpp" ${ARGN})
    if(EMSCRIPTEN AND LIBRARY_TEST_HOST)
        get_property(library_test_host_dir GLOBAL PROPERTY PLATFORM_TEST_HOST_DIR)
        target_link_options(${target} PRIVATE -sMODULARIZE=1 -sEXPORT_NAME=createLibraryTest
            -sENVIRONMENT=web,node -sINVOKE_RUN=0 -sEXPORTED_RUNTIME_METHODS=callMain
            "SHELL:--pre-js \"${library_test_host_dir}/LibraryTestPre.js\"")
        foreach(file IN ITEMS LibraryTestHost.js LibraryTestHost.html LibraryTestWidth.js LibraryTestMemory64.wasm)
            configure_file("${library_test_host_dir}/${file}" "${CMAKE_CURRENT_BINARY_DIR}/${file}" COPYONLY)
        endforeach()
        add_test(NAME ${target} COMMAND ${CMAKE_CROSSCOMPILING_EMULATOR}
            "${CMAKE_CURRENT_BINARY_DIR}/LibraryTestHost.js" "$<TARGET_FILE:${target}>")
        if(LIBRARY_TEST_BENCHMARKS)
            add_test(NAME ${target}Benchmark COMMAND ${CMAKE_CROSSCOMPILING_EMULATOR}
                "${CMAKE_CURRENT_BINARY_DIR}/LibraryTestHost.js" "$<TARGET_FILE:${target}>" --benchmark)
        endif()
    else()
        add_platform_test(${target} ${target})
        if(LIBRARY_TEST_BENCHMARKS)
            add_platform_test(${target}Benchmark ${target} --benchmark)
        endif()
    endif()
    if(LIBRARY_TEST_BENCHMARKS)
        set_tests_properties(${target}Benchmark PROPERTIES LABELS performance RUN_SERIAL TRUE)
    endif()
endfunction()

# 用同一 SDK 构建只有一个 C++ 主入口的专项测试。PROJECTS 按使用方在前排列，
# ARCHIVES 是 before 已发布的第三方文件名；应用进程由对应解决方案另行构建。
function(build_sdk_test target)
    cmake_parse_arguments(suite "" "" "PROJECTS;ARCHIVES;SYSTEM_LIBRARIES" ${ARGN})
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND BIT MATCHES "^arm(32|64)$")
        include(CheckCXXSourceCompiles)
        if(BIT STREQUAL "arm32")
            set(test_abi "defined(__arm__) && defined(__ARM_PCS_VFP) && __SIZEOF_POINTER__ == 4")
        else()
            set(test_abi "defined(__aarch64__) && __SIZEOF_POINTER__ == 8")
        endif()
        check_cxx_source_compiles("#if !(${test_abi})\n#error Wrong ARM ABI\n#endif\nint main(){return 0;}" test_abi_${BIT})
        if(NOT test_abi_${BIT})
            message(FATAL_ERROR "The configured compiler does not target Linux ${BIT}")
        endif()
    endif()
    if(NOT SDK_ROOT)
        set(SDK_ROOT "$ENV{CLOUD_REBUILD_SDK_ROOT}")
    endif()
    if(NOT SDK_ROOT)
        get_filename_component(SDK_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/../../.." ABSOLUTE)
    endif()
    file(TO_CMAKE_PATH "${SDK_ROOT}" SDK_ROOT)
    if(MSVC)
        set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:DebugDLL>")
    endif()
    add_executable(${target} "${target}.cpp")
    target_compile_features(${target} PRIVATE cxx_std_11)
    platform_test_link(${target} "${SDK_ROOT}")
    set(archives)
    if(EMSCRIPTEN)
        platform_test_wasm_headers(${target} "${SDK_ROOT}" ${suite_PROJECTS})
        math(EXPR width "${CMAKE_SIZEOF_VOID_P} * 8")
        if(BIT AND NOT BIT STREQUAL "wasm${width}")
            message(FATAL_ERROR "${BIT} disagrees with the ${width}-bit compiler")
        endif()
        target_compile_definitions(${target} PRIVATE STATIC_LIB)
        target_compile_options(${target} PRIVATE -fexceptions)
        target_link_options(${target} PRIVATE -fexceptions -sALLOW_MEMORY_GROWTH=1)
        foreach(name IN LISTS suite_PROJECTS)
            list(APPEND archives "${SDK_ROOT}/lib/${name}$<$<CONFIG:Debug>:d>.a")
        endforeach()
    else()
        foreach(name IN LISTS suite_PROJECTS)
            platform_test_sdk_library(library "${name}")
            list(APPEND archives "${library}")
        endforeach()
        find_package(Threads REQUIRED)
        list(APPEND suite_SYSTEM_LIBRARIES Threads::Threads ${CMAKE_DL_LIBS})
    endif()
    if(EMSCRIPTEN)
        target_include_directories(${target} BEFORE PRIVATE "${SDK_ROOT}/include/protobuf-3.3.0")
    else()
        target_include_directories(${target} BEFORE PRIVATE "${SDK_ROOT}/include/protobuf")
    endif()
    target_link_directories(${target} PRIVATE "${SDK_ROOT}/lib")
    foreach(name IN LISTS suite_ARCHIVES LIBRARIESRELY)
        if(IS_ABSOLUTE "${name}")
            list(APPEND archives "${name}")
        else()
            list(APPEND archives "${SDK_ROOT}/lib/${name}")
        endif()
    endforeach()
    if(CMAKE_SYSTEM_NAME MATCHES "^(Linux|Android)$")
        target_link_libraries(${target} PRIVATE "-Wl,--start-group" ${archives} "-Wl,--end-group")
    else()
        target_link_libraries(${target} PRIVATE ${archives})
    endif()
    target_link_libraries(${target} PRIVATE ${suite_SYSTEM_LIBRARIES})
    if(BUILD_TESTING)
        add_library_platform_test(${target} TAKES_ARGS)
    endif()
endfunction()
