.media-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 4rpx;
  margin: 0 -24rpx;
}

.media-tile {
  position: relative;
  width: 100%;
  height: 0;
  padding-top: 133.333333%;
  overflow: hidden;
}

.media-cover,
.media-cover-empty {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.media-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7b746a;
  font-size: 22rpx;
}

.media-title {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 24rpx 10rpx 10rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
  color: #fff;
  font-size: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}