.cached-player {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #000;
}

.cached-canvas,
.cached-preview {
  display: block;
  width: 100%;
  height: 100%;
}

.player-status {
  position: absolute;
  left: 50%;
  top: 50%;
  max-width: 80%;
  padding: 12rpx 20rpx;
  transform: translate(-50%, -50%);
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.64);
  color: #fff;
  font-size: 24rpx;
  text-align: center;
}