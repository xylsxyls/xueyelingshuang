.bottom-navigation { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; height: calc(50px + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); display: flex; background: #fffdf8; border-top: 1px solid #eee6d8; box-sizing: border-box; }
.navigation-item { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; font-size: 14px; color: #7b746a; }
.navigation-pressed { background: #ebe5d9; color: #18231f; }