<view class="page"><view class="review-player" wx:if="{{videoId}}"><cached-video-player id="reviewVideo" video-id="{{videoId}}" video-url="{{videoUrl}}" active="{{active}}" autoplay="{{playing}}" bindplayertap="toggle" bindtimeupdate="onTime" bindloadedmetadata="onMetadata" binderror="onError"/><slider min="0" max="{{duration || 1}}" value="{{current}}" bindchange="seek"/><button bindtap="toggle">{{playing ? '暂停' : '播放'}}</button></view><block wx:elif="{{images.length}}"><image class="review-image" src="{{image}}" mode="aspectFit"/><view class="toolbar"><button data-offset="-1" bindtap="changeImage" disabled="{{imageIndex <= 0}}">上一张</button><text>{{imageIndex + 1}} / {{images.length}}</text><button data-offset="1" bindtap="changeImage" disabled="{{imageIndex + 1 >= images.length}}">下一张</button></view></block><view class="card" wx:if="{{loading}}">正在加载媒体…</view><view class="card" wx:if="{{error}}">{{error}}</view></view>