<view class="page voice-page">
  <view class="card option {{voiceGender === 'female' ? 'active' : ''}}" data-value="female" bindtap="choose">
    <view>
      <view class="title">女声</view>
      <view class="muted">温和、提示感更轻</view>
    </view>
    <view class="check">{{voiceGender === 'female' ? '已选' : ''}}</view>
  </view>
  <view class="card option {{voiceGender === 'male' ? 'active' : ''}}" data-value="male" bindtap="choose">
    <view>
      <view class="title">男声</view>
      <view class="muted">清晰、提示感更强</view>
    </view>
    <view class="check">{{voiceGender === 'male' ? '已选' : ''}}</view>
  </view>
  <view class="hint">当前语音方案：{{providerLabel}}。后续可在配置中切换前端插件或服务端语音。</view>
</view>
