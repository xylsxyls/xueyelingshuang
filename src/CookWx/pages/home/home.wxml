<view class="home-page">
  <view class="top-tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="*this"
      class="tab {{activeTab === item ? 'active' : ''}}"
      data-tab="{{item}}"
      bindtap="switchTab"
    >{{item}}</view>
  </view>

  <swiper class="feed-swiper" vertical="true" circular="{{false}}" current="{{currentIndex}}" bindchange="onSwiperChange" bindtransition="onSwiperTransition" bindanimationfinish="onSwiperAnimationFinish">
    <swiper-item wx:for="{{feed}}" wx:key="feedKey">
      <view class="feed-card">
        <image
          wx:if="{{item.posterSrc && (!item.videoFrameReady || index !== currentIndex)}}"
          class="feed-poster"
          data-index="{{index}}"
          src="{{item.posterSrc}}"
          mode="aspectFill"
          bindload="onPosterLoad"
          binderror="onPosterError"
        ></image>
        <video
          wx:if="{{item.videoUrl}}"
          id="feedVideo{{index}}"
          class="feed-video"
          data-index="{{index}}"
          src="{{item.videoUrl}}"
          poster="{{item.posterSrc}}"
          autoplay="{{index === currentIndex && !videoPaused}}"
          loop="{{true}}"
          muted="{{false}}"
          controls="{{false}}"
          show-center-play-btn="{{false}}"
          show-play-btn="{{false}}"
          show-fullscreen-btn="{{false}}"
          enable-progress-gesture="{{false}}"
          enable-play-gesture="{{false}}"
          preload="{{index === currentIndex ? 'auto' : 'metadata'}}"
          object-fit="cover"
          bindtap="onVideoTap"
          bindplay="onVideoPlay"
          bindpause="onVideoPause"
          bindtimeupdate="onVideoTimeUpdate"
          bindloadedmetadata="onVideoLoadedMetadata"
          bindcanplay="onVideoCanPlay"
          bindwaiting="onVideoWaiting"
          bindseekcomplete="onVideoSeekComplete"
          binderror="onVideoError"
        ></video>
        <view class="video-shade" wx:if="{{item.videoUrl}}"></view>
        <view class="pause-overlay" wx:if="{{item.videoUrl && index === currentIndex && videoPaused}}">
          <view class="pause-triangle"></view>
        </view>

        <view class="feed-actions" wx:if="{{item.videoUrl}}">
          <view class="creator-action">
            <view class="creator-avatar">{{item.authorInitial}}</view>
            <view class="creator-follow" wx:if="{{item.canFollowAuthor}}" data-index="{{index}}" bindtap="followAuthor">+</view>
            <view class="creator-follow followed" wx:elif="{{item.followConfirmVisible}}">
              <view class="check-shape"></view>
            </view>
          </view>
          <view class="action-item" data-index="{{index}}" bindtap="toggleLike">
            <view class="action-icon heart {{item.liked ? 'active' : ''}}">
              <view class="heart-shape"></view>
            </view>
            <view class="action-label">{{item.likes || 0}}</view>
          </view>
          <view class="action-item" bindtap="openComments">
            <view class="action-icon comment">
              <view class="comment-icon-shape">
                <view class="comment-tail"></view>
              </view>
            </view>
            <view class="action-label">{{item.comments || 0}}</view>
          </view>
          <view class="action-item" data-index="{{index}}" bindtap="favorite">
            <view class="action-icon star {{item.favorite ? 'active' : ''}}">
              <view class="star-shape"></view>
            </view>
            <view class="action-label">{{item.favorite ? '已收藏' : '收藏'}}</view>
          </view>
        </view>

        <view class="feed-info" wx:if="{{item.videoUrl}}">
          <view class="author">@{{item.author}}</view>
          <view class="title">{{item.title}}</view>
          <view class="desc">{{item.description}}</view>
          <view class="metrics">{{item.likes}}赞 · {{item.comments}}评论</view>
          <view class="recipe-row">
            <button class="recipe-btn" data-index="{{index}}" bindtap="handleRecipeAction" loading="{{buyingRecipeId && buyingRecipeId === item.primaryRecipeId}}">
              {{item.actionText}}
            </button>
            <button class="ghost-recipe-btn" data-index="{{index}}" bindtap="addToMenu" wx:if="{{item.canAddToMenu}}">{{item.menuText}}</button>
          </view>
        </view>
        <view
          class="video-progress"
          wx:if="{{item.videoUrl && index === currentIndex}}"
          data-index="{{index}}"
          catchtap="onProgressAreaTap"
          catchtouchstart="onProgressTouchStart"
          catchtouchmove="onProgressTouchMove"
          catchtouchend="onProgressTouchEnd"
          catchtouchcancel="onProgressTouchCancel"
        >
          <view class="progress-time-tip" wx:if="{{showProgressHint}}">{{progressHintText}}</view>
          <view class="progress-track">
            <view class="progress-fill" style="width: {{videoProgressPercent}}%;"></view>
            <view class="progress-thumb" style="left: {{videoProgressPercent}}%;"></view>
          </view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="poster-preload-box" wx:if="{{posterPreloadList.length}}">
    <image
      wx:for="{{posterPreloadList}}"
      wx:key="feedKey"
      class="poster-preload-image"
      data-index="{{item.index}}"
      data-video-id="{{item.videoId}}"
      src="{{item.posterUrl}}"
      mode="aspectFill"
      bindload="onPosterPreloadLoad"
      binderror="onPosterPreloadError"
    ></image>
  </view>

  <view class="feed-empty" wx:if="{{!loading && !error && !feed.length}}">
    当前还没有可播放视频。
  </view>

  <view class="offline" wx:if="{{error}}">
    <view>{{error}}</view>
    <button bindtap="loadData">重试</button>
  </view>
</view>