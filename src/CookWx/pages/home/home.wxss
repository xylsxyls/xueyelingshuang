.home-page {
  height: 100vh;
  background: #111814;
  overflow: hidden;
}

.top-tabs {
  position: fixed;
  z-index: 10;
  top: 18rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 30rpx;
  color: rgba(255, 253, 248, 0.72);
  font-size: 29rpx;
}

.tab {
  padding: 12rpx 0;
}

.tab.active {
  color: #fffdf8;
  border-bottom: 4rpx solid #fffdf8;
}

.feed-swiper {
  height: 100vh;
}

.feed-card {
  position: relative;
  height: 100vh;
  padding: 96rpx 28rpx 150rpx;
  color: #fffdf8;
  overflow: hidden;
}

.feed-video,
.feed-poster {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.feed-poster {
  z-index: 3;
  pointer-events: none;
}

.feed-video {
  z-index: 1;
}

.poster-preload-box {
  position: fixed;
  left: -100rpx;
  top: -100rpx;
  width: 1rpx;
  height: 1rpx;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
}

.poster-preload-image {
  width: 1rpx;
  height: 1rpx;
}

.video-shade {
  position: absolute;
  z-index: 2;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0.04) 34%, rgba(0, 0, 0, 0.46));
}

.pause-overlay {
  position: absolute;
  z-index: 5;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.pause-triangle {
  width: 0;
  height: 0;
  border-top: 42rpx solid transparent;
  border-bottom: 42rpx solid transparent;
  border-left: 68rpx solid rgba(255, 255, 255, 0.62);
  filter: drop-shadow(0 6rpx 20rpx rgba(0, 0, 0, 0.32));
}

.feed-actions {
  position: absolute;
  z-index: 4;
  right: 24rpx;
  bottom: 230rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 26rpx;
}

.creator-action,
.action-item {
  width: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.creator-action {
  position: relative;
  margin-bottom: 4rpx;
}

.creator-avatar {
  width: 84rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  background: #fffdf8;
  color: #18231f;
  font-size: 34rpx;
  font-weight: 900;
  box-shadow: 0 6rpx 22rpx rgba(0, 0, 0, 0.22);
}

.creator-follow {
  position: absolute;
  left: 50%;
  bottom: -16rpx;
  transform: translateX(-50%);
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 18rpx;
  background: #ff3158;
  color: #fffdf8;
  font-size: 28rpx;
  font-weight: 900;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.25);
}

.creator-follow.followed {
  background: #26b763;
  font-size: 24rpx;
}

.check-shape {
  width: 18rpx;
  height: 10rpx;
  margin: 9rpx auto 0;
  border-left: 5rpx solid #fffdf8;
  border-bottom: 5rpx solid #fffdf8;
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.action-icon {
  width: 88rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  filter: drop-shadow(0 4rpx 12rpx rgba(0, 0, 0, 0.38));
}

.heart-shape {
  width: 62rpx;
  height: 56rpx;
  background: #fffdf8;
  clip-path: polygon(50% 93%, 12% 57%, 5% 45%, 3% 29%, 8% 15%, 20% 6%, 34% 6%, 45% 15%, 50% 24%, 55% 15%, 66% 6%, 80% 6%, 92% 15%, 97% 29%, 95% 45%, 88% 57%);
}

.action-icon.heart.active .heart-shape {
  background: #ff3158;
}

.star-shape {
  width: 62rpx;
  height: 62rpx;
  background: #fffdf8;
  clip-path: polygon(50% 3%, 61% 35%, 95% 35%, 68% 55%, 79% 90%, 50% 69%, 21% 90%, 32% 55%, 5% 35%, 39% 35%);
}

.action-icon.star.active .star-shape {
  background: #ffd34d;
}

.action-icon.comment {
  display: flex;
  align-items: center;
  justify-content: center;
}

.comment-icon-shape {
  position: relative;
  width: 56rpx;
  height: 40rpx;
  background: #fffdf8;
  border-radius: 13rpx;
}

.comment-tail {
  position: absolute;
  right: 8rpx;
  bottom: -7rpx;
  width: 16rpx;
  height: 16rpx;
  background: #fffdf8;
  transform: rotate(42deg);
}

.action-label {
  margin-top: 2rpx;
  color: #fffdf8;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  text-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.42);
}

.feed-info {
  position: absolute;
  z-index: 4;
  left: 28rpx;
  right: 120rpx;
  bottom: 142rpx;
  text-shadow: 0 2rpx 14rpx rgba(0, 0, 0, 0.25);
}

.author {
  font-size: 27rpx;
  margin-bottom: 12rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.desc {
  font-size: 28rpx;
  line-height: 1.45;
}

.metrics {
  margin-top: 12rpx;
  color: rgba(255, 253, 248, 0.8);
  font-size: 24rpx;
}

.recipe-row {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.recipe-btn,
.ghost-recipe-btn {
  margin: 0;
  padding: 0 22rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
}

.recipe-btn {
  background: #fffdf8;
  color: #18231f;
}

.ghost-recipe-btn {
  background: rgba(255, 253, 248, 0.22);
  color: #fffdf8;
}

.offline {
  position: fixed;
  z-index: 12;
  left: 32rpx;
  right: 32rpx;
  top: 160rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #fffdf8;
  color: #18231f;
}

.offline button {
  margin-top: 16rpx;
  background: #18231f;
  color: #fffdf8;
}

.video-progress {
  position: absolute;
  z-index: 6;
  left: 24rpx;
  right: 24rpx;
  bottom: 78rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
}

.progress-track {
  position: relative;
  width: 100%;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.28);
  overflow: visible;
}

.progress-time-tip {
  position: absolute;
  left: 50%;
  bottom: 42rpx;
  transform: translateX(-50%);
  min-width: 150rpx;
  max-width: 360rpx;
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  background: rgba(24, 35, 31, 0.82);
  color: #fffdf8;
  font-size: 24rpx;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
}

.progress-fill {
  height: 100%;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.92);
}

.progress-thumb {
  position: absolute;
  top: 50%;
  width: 24rpx;
  height: 24rpx;
  margin-top: -12rpx;
  margin-left: -12rpx;
  border-radius: 50%;
  background: #fffdf8;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.28);
}

.feed-empty {
  position: fixed;
  z-index: 11;
  left: 32rpx;
  right: 32rpx;
  top: 180rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: rgba(255, 253, 248, 0.94);
  color: #18231f;
  font-size: 27rpx;
  text-align: center;
}