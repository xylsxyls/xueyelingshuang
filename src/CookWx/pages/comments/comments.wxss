.comments-page { min-height: 100vh; padding: 28rpx 28rpx 180rpx; box-sizing: border-box; background: #f7f5ef; color: #252c28; }
.comments-title { margin-bottom: 24rpx; font-size: 34rpx; font-weight: 700; }
.empty { padding: 64rpx 20rpx; color: #778079; text-align: center; }
.comment-row { display: flex; gap: 18rpx; padding: 22rpx 0; border-bottom: 1rpx solid #e7e5de; }
.avatar { width: 68rpx; height: 68rpx; flex: 0 0 68rpx; border-radius: 50%; background: #dfe8df; color: #315541; line-height: 68rpx; text-align: center; font-weight: 700; }
.comment-content { min-width: 0; flex: 1; }
.comment-author { font-size: 25rpx; font-weight: 600; color: #58645c; }
.comment-text { margin-top: 8rpx; font-size: 29rpx; line-height: 1.55; word-break: break-word; }
.comment-time { margin-top: 8rpx; font-size: 22rpx; color: #8a938c; }
.composer { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: flex-end; gap: 16rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -4rpx 18rpx rgba(32, 45, 36, .08); }
.comment-input { flex: 1; min-height: 72rpx; max-height: 220rpx; padding: 16rpx 20rpx; border-radius: 20rpx; background: #f2f3ef; font-size: 27rpx; }
.send-button { flex: 0 0 132rpx; margin: 0; font-size: 26rpx; }
