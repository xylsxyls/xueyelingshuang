<view class="page recipe-page" wx:if="{{recipe}}">
  <view class="recipe-hero" bindtap="openVideo">
    <image wx:if="{{recipe.thumbnailUrl}}" class="recipe-hero-image" src="{{recipe.thumbnailUrl}}" mode="aspectFill" data-url="{{recipe.thumbnailUrl}}" binderror="onCoverError"></image>
    <view class="recipe-hero-empty" wx:else>暂无视频封面</view>
    <view class="recipe-hero-gradient"></view>
    <view class="recipe-hero-play" wx:if="{{recipe.videoId}}"><view class="recipe-hero-triangle"></view></view>
  </view>
  <view class="recipe-heading">
    <view class="hero-title">{{recipe.title}}</view>
    <view class="hero-subtitle">{{recipe.subtitle}}</view>
    <view class="recipe-author">{{recipe.author}}</view>
    <view class="tag-row"><view wx:for="{{recipe.tags}}" wx:key="*this" class="tag">{{item}}</view></view>
  </view>

  <view class="summary card">
    <view>
      <view class="num">{{recipe.estimatedMinutes}}</view>
      <view class="label">预计分钟</view>
    </view>
    <view>
      <view class="num">{{recipe.activeMinutes}}</view>
      <view class="label">动手分钟</view>
    </view>
    <view>
      <view class="num">{{recipe.priceAmount || 0}}</view>
      <view class="label">{{recipe.priceLabel}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">准备食材</view>
    <view class="ingredient" wx:for="{{recipe.ingredients}}" wx:key="name">
      <text>{{item.name}}</text>
      <text class="muted">{{item.amount}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">需要工具</view>
    <view class="tool-row">
      <view class="tool" wx:for="{{recipe.tools}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <view class="section" wx:if="{{recipe.accessible && recipe.tasks.length}}">
    <view class="section-title">制作步骤</view>
    <view class="step card" wx:for="{{recipe.tasks}}" wx:key="id">
      <view class="step-title">{{index + 1}}. {{item.title}}</view>
      <view class="muted">{{item.detailText}}</view>
    </view>
  </view>

  <view class="purchase card" wx:if="{{!recipe.accessible}}">
    <view>
      <view class="section-title">购买后解锁详细步骤</view>
      <view class="muted">加入菜单不扣费，购买后可参与多菜并行排程。</view>
    </view>
    <button class="primary-btn" bindtap="purchase" loading="{{buying}}" disabled="{{buying}}">{{recipe.purchaseText}}</button>
  </view>

  <view class="action-bar">
    <button class="ghost-btn" bindtap="openPersonalization" disabled="{{!recipe.accessible}}">个性化</button>
    <button class="primary-btn" bindtap="addToMenu" loading="{{joining}}" disabled="{{joining || (mealSelection ? selectedForMeal : recipe.inMenu)}}">{{(mealSelection ? selectedForMeal : recipe.inMenu) ? '已加入菜单' : '加入菜单'}}</button>
  </view>
</view>

<view class="page" wx:else>
  <view class="card empty">{{error || (loading ? '正在加载菜谱...' : '菜谱不存在')}}</view>
</view>