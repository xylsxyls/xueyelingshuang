@import "../../styles/recipeHero.wxss";
.recipe-page {
  padding-bottom: 150rpx;
}

.hero {
  min-height: 360rpx;
  padding: 48rpx 32rpx;
  color: #fffdf8;
  border-radius: 8rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 800;
  margin-top: 90rpx;
}

.hero-subtitle {
  margin-top: 16rpx;
  font-size: 29rpx;
  line-height: 1.5;
}

.tag-row,
.tool-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag,
.tool {
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 253, 248, 0.22);
  color: #fffdf8;
  font-size: 24rpx;
}

.tool {
  background: #ebe5d9;
  color: #18231f;
}

.summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 24rpx;
  margin-top: 20rpx;
  text-align: center;
}

.num {
  font-size: 42rpx;
  font-weight: 800;
}

.label {
  color: #7b746a;
  font-size: 23rpx;
  margin-top: 6rpx;
}

.section {
  margin-top: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.ingredient {
  display: flex;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eee6d8;
}

.step {
  padding: 22rpx;
  margin-bottom: 14rpx;
}

.step-title {
  margin-bottom: 10rpx;
  font-weight: 700;
}

.purchase {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  margin-top: 32rpx;
}

.purchase button {
  width: 220rpx;
  margin: 0;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: 170rpx 170rpx 1fr;
  gap: 16rpx;
  padding: 20rpx 24rpx 34rpx;
  background: #fffdf8;
  border-top: 1rpx solid #eee6d8;
}

.empty {
  padding: 32rpx;
}

.hero { position: relative; height: 360rpx; min-height: 0; padding: 0; overflow: hidden; background: #eeeae4; }
.hero-image { width: 100%; height: 100%; }
.hero-gradient { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(to bottom, rgba(248,245,239,0) 50%, #f8f5ef 100%); pointer-events: none; }
.hero-play { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); padding: 28rpx; }
.hero-triangle { width: 0; height: 0; border-top: 28rpx solid transparent; border-bottom: 28rpx solid transparent; border-left: 44rpx solid rgba(255,255,255,.8); filter: drop-shadow(0 1rpx 4rpx rgba(0,0,0,.4)); }
.hero-empty { height: 100%; display: flex; align-items: center; justify-content: center; color: #8c857b; }
.recipe-heading { margin: 12rpx 0 28rpx; }
.recipe-author { color: #8c857b; margin-top: 12rpx; font-size: 24rpx; }
.action-bar { display: flex; gap: 20rpx; }
.action-bar button { flex: 1; width: 0; display: flex; align-items: center; justify-content: center; }
.recipe-heading .hero-title { margin-top: 0; }
.action-bar button { height: 80rpx; padding: 0; }
.purchase button { min-height: 72rpx; display: flex; align-items: center; justify-content: center; }