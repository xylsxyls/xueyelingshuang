<view class="conversation"><view class="chat-header">{{profile.nickname || '私信'}}<text class="muted">{{profile.friend ? ' · 好友' : ' · 消息免打扰'}}</text></view><scroll-view class="chat-list" scroll-y="{{true}}" scroll-into-view="{{scrollTarget}}"><view class="load-older" wx:if="{{hasMore}}" bindtap="loadOlder">查看更早消息</view><view wx:for="{{messages}}" wx:key="id" id="chat-{{item.id}}" class="chat-row {{item.outgoing ? 'outgoing' : ''}}"><view class="bubble">{{item.text}}</view></view><view class="chat-error" wx:if="{{error}}" bindtap="retry">{{error}}，点击重试</view></scroll-view><view class="chat-compose" wx:if="{{profile.following}}"><input maxlength="200" value="{{text}}" bindinput="onInput" placeholder="输入消息" confirm-type="send" bindconfirm="send"/><button bindtap="send" loading="{{sending}}" disabled="{{sending || !text}}">发送</button></view><view class="chat-hint" wx:else>关注对方后可以发送私信</view></view>