<view class="page personalization-page" wx:if="{{recipe}}">
  <view class="recipe-hero" bindtap="openMedia"><image wx:if="{{recipe.thumbnailUrl}}" class="recipe-hero-image" src="{{recipe.thumbnailUrl}}" mode="aspectFill"/><view class="recipe-hero-gradient"/><view class="recipe-hero-play"><view class="recipe-hero-triangle"/></view></view>
  <view class="header"><view class="title">{{recipe.title}}</view><view class="subtitle">{{recipe.subtitle}}</view></view>
  <view class="card"><view class="review-status">{{record.requiresReview ? '第' + record.reviewNumber + '次审核' : '免费发布'}} · {{reviewStatus}}</view><view>提交：{{submittedText}}</view><view>审核：{{reviewedText}}</view><view wx:if="{{record.reviewerName}}">审核员：{{record.reviewerName}}</view><view wx:if="{{record.reason}}" class="review-reason">原因：{{record.reason}}</view></view>
  <view class="card"><view>定价：{{recipe.priceType === 'free' ? '免费' : recipe.priceAmount + (recipe.priceType === 'coin' ? '金币' : '元宝')}}</view><picker range="{{history}}" range-key="label" bindchange="selectHistory" disabled="{{deciding}}"><view class="history-link">切换历史投稿 ⌄</view></picker><button wx:if="{{historyHasMore}}" class="ghost-btn" bindtap="moreHistory">加载更早的历史</button></view>
  <view class="card"><view class="step-title">与上次通过版本比较</view><view wx:if="{{!previous}}">尚无上次通过版本，下面是首次投稿内容。</view><block wx:else><button class="ghost-btn" data-previous="{{true}}" bindtap="openMedia">查看上次通过的视频／图片组</button><view class="review-change" wx:for="{{changes}}" wx:key="field"><view>{{item.label}}：{{item.current}}</view><view class="previous-value">上次：{{item.previous}}</view></view><view wx:if="{{!changes.length}}">基本资料及价格未变，步骤差异标在各步下面。</view></block></view>
  <view class="step-card card" wx:for="{{steps}}" wx:key="id"><view class="step-head"><view class="step-title">第{{item.index}}步 {{item.title}}</view><text>{{item.active ? '前台' : '后台'}}</text></view><view class="step-detail">{{item.detail}}</view><view class="duration-row">{{item.hours}}时 {{item.minutes}}分 {{item.seconds}}秒</view><view class="previous-value" wx:for="{{item.changes}}" wx:for-item="change" wx:key="*this">{{change}}</view></view>
  <view class="card" wx:if="{{removedSteps.length}}"><view class="review-reason">本次删除的步骤</view><view wx:for="{{removedSteps}}" wx:key="id">{{item.title}} · {{item.durationSeconds}}秒 · {{item.detail}}</view></view>
  <view class="card" wx:if="{{canDecide}}"><textarea class="step-detail-editor" placeholder="不通过原因（选填，最多500字）" value="{{reason}}" maxlength="1000" bindinput="onReason" disabled="{{deciding}}"/><view class="toolbar"><button class="ghost-btn danger" data-decision="rejected" bindtap="decide" disabled="{{deciding}}">不通过</button><button class="primary-btn" data-decision="approved" bindtap="decide" loading="{{deciding}}" disabled="{{deciding}}">通过</button></view></view>
  <view class="card review-reason" wx:if="{{error}}">{{error}}</view>
</view>
<view class="page" wx:else><view class="card">{{error || '正在加载审核内容…'}}</view><button bindtap="load" disabled="{{loading}}">重试</button></view>