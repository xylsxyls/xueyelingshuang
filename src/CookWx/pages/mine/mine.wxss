@import "../../styles/recipeBuyButton.wxss";
@import "../../styles/userProfile.wxss";
@import "../../styles/mediaGrid.wxss";
.mine-loading { padding: 20rpx; margin-bottom: 16rpx; }
.introduction-input { flex: 1; min-width: 0; font-size: 25rpx; color: #7b746a; background: #f8f5ef; height: 52rpx; padding: 0 10rpx; border-bottom: 1rpx solid #8d4b35; }
.introduction-action, .logout-inline { flex-shrink: 0; margin: 0; padding: 0 6rpx; line-height: 44rpx; font-size: 22rpx; background: transparent; color: #8d4b35; }
.fans-link { color: #8d4b35; }
.logout-inline { margin-left: auto; color: #7b746a; }
.wallet { display: flex; align-items: center; gap: 20rpx; margin-top: 18rpx; padding: 16rpx 20rpx; }
.wallet-balances { flex: 1; min-width: 0; display: flex; align-items: center; }
.wallet-balances > view { flex: 1; min-width: 0; }
.wallet-num { font-size: 40rpx; font-weight: 800; }
.wallet-actions { flex: 0 0 156rpx; display: flex; flex-direction: column; gap: 8rpx; }
.wallet-actions button { width: 100%; margin: 0; height: 52rpx; display: flex; align-items: center; justify-content: center; padding: 0; font-size: 23rpx; background: #ebe5d9; }
.asset-card { display: flex; gap: 18rpx; align-items: flex-start; padding: 18rpx; margin-bottom: 12rpx; }
.cover { width: 104rpx; height: 104rpx; flex-shrink: 0; border-radius: 8rpx; }
.cover-empty { display: flex; align-items: center; justify-content: center; font-size: 20rpx; background: #eeeae4; color: #8c857b; }
.asset-main { flex: 1; min-width: 0; }
.asset-title-row { display: flex; align-items: center; gap: 12rpx; }
.recipe-title { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 800; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.asset-badge { flex-shrink: 0; padding: 5rpx 12rpx; background: #e5f1dc; color: #2e6f45; font-size: 21rpx; }
.asset-summary { margin-top: 8rpx; color: #2e6f45; font-size: 23rpx; }
.menu-row-actions { display: flex; justify-content: flex-end; margin-top: 12rpx; }
.remove-menu { margin: 0; padding: 0 10rpx; background: transparent; color: #8c857b; font-size: 23rpx; line-height: 50rpx; }
.empty { padding: 28rpx; color: #7b746a; }
.asset-load-error,
.asset-load-more {
  padding: 24rpx;
  text-align: center;
  color: #7b746a;
  font-size: 24rpx;
}
.review-switch-icon { width: 18rpx; margin-left: 4rpx; }
.review-switch-icon view { width: 16rpx; height: 6rpx; border-top: 2rpx solid currentColor; }
.review-switch-icon view:first-child { border-right: 2rpx solid currentColor; transform: skewX(35deg); }
.review-switch-icon view:last-child { border-left: 2rpx solid currentColor; transform: skewX(35deg); margin-top: 2rpx; }
.review-reason { color: #a33f33; font-size: 24rpx; word-break: break-all; }