.media {
  min-height: 420rpx;
  overflow: hidden;
}

.preview {
  width: 100%;
  height: 420rpx;
  display: block;
}

.placeholder {
  height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #7b746a;
}

.plus {
  width: 88rpx;
  height: 88rpx;
  line-height: 82rpx;
  text-align: center;
  border-radius: 44rpx;
  border: 2rpx solid #7b746a;
  font-size: 56rpx;
  margin-bottom: 18rpx;
}

.caption {
  width: 100%;
  min-height: 150rpx;
  padding: 22rpx;
  margin-top: 20rpx;
}

.section-title {
  margin: 34rpx 0 16rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.recipe {
  display: grid;
  grid-template-columns: 92rpx 1fr 72rpx;
  gap: 16rpx;
  align-items: center;
  padding: 18rpx;
  margin-bottom: 12rpx;
}

.cover {
  width: 92rpx;
  height: 92rpx;
  border-radius: 8rpx;
}

.recipe-main {
  line-height: 1.5;
  font-weight: 700;
}

.checked {
  color: #5f8f70;
  font-size: 23rpx;
}

.publish-btn {
  margin-top: 28rpx;
  height: 82rpx;
}