.fan { display: flex; align-items: center; gap: 24rpx; }
.fan-avatar { width: 88rpx; height: 88rpx; border-radius: 50%; background: #eeeae4; flex-shrink: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.fan-avatar image { width: 100%; height: 100%; }
.fan-info { flex: 1; min-width: 0; }
.fan-name { font-size: 30rpx; margin-bottom: 12rpx; }
.fan-info .muted { font-size: 24rpx; }