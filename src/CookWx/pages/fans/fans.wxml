<view class="page"><view class="fan card" wx:for="{{users}}" wx:key="userId" data-id="{{item.userId}}" bindtap="openUser"><view class="fan-avatar"><image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill"></image><text wx:else>厨</text></view><view class="fan-info"><view class="fan-name">{{item.nickname}}</view><view class="muted">{{item.introduction || '暂无介绍'}}</view></view><text class="muted">{{item.friend ? '好友' : ''}}</text></view><view class="empty" wx:if="{{!users.length && !loading && !error}}">暂时还没有粉丝</view><view class="empty" wx:if="{{loading}}">加载中…</view><view class="empty" wx:if="{{error}}" bindtap="load">{{error}}，点击重试</view></view>